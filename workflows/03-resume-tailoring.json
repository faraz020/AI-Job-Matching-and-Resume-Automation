    {
      "parameters": {
        "jsCode": "const raw = $json.text;\n\nlet cleaned = raw;\n\n// Remove Markdown fences if present\ncleaned = cleaned\n  .replace(/^```json\\s*/i, '')\n  .replace(/^```\\s*/i, '')\n  .replace(/\\s*```$/i, '')\n  .trim();\n\nconst start = cleaned.indexOf('{');\nconst end = cleaned.lastIndexOf('}');\n\nif (start === -1 || end === -1) {\n  throw new Error('No valid JSON object found in LLM output');\n}\n\nconst evaluation = JSON.parse(cleaned.slice(start, end + 1));\n\nreturn {\n  json: evaluation\n};"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1280,
        96
      ],
      "id": "8f081c49-77ec-45b1-89d9-c031897a6d3b",
      "name": "json converter"
    },
    {
      "parameters": {
        "jsCode": "const data = $('json converter').item.json;\n\nconst body = {\n  requests: [\n    { replaceAllText: { containsText: { text: \"{{summary}}\", matchCase: true }, replaceText: data.summary } },\n    { replaceAllText: { containsText: { text: \"{{project_1_title}}\", matchCase: true }, replaceText: data.project_1_title } },\n    { replaceAllText: { containsText: { text: \"{{project_1_description}}\", matchCase: true }, replaceText: data.project_1_description } },\n    { replaceAllText: { containsText: { text: \"{{project_2_title}}\", matchCase: true }, replaceText: data.project_2_title } },\n    { replaceAllText: { containsText: { text: \"{{project_2_description}}\", matchCase: true }, replaceText: data.project_2_description } },\n    { replaceAllText: { containsText: { text: \"{{project_3_title}}\", matchCase: true }, replaceText: data.project_3_title } },\n    { replaceAllText: { containsText: { text: \"{{project_3_description}}\", matchCase: true }, replaceText: data.project_3_description } },\n    { replaceAllText: { containsText: { text: \"{{skills_list}}\", matchCase: true }, replaceText: data.skills_list } }\n  ]\n};\n\nreturn [{ json: { batchBody: body } }];"
      },
      "type": "n8n-nodes-base.code",
