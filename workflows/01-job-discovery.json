      "name": "remote ok api"
    },
    {
      "parameters": {
        "jsCode": "const techKeywords = [\n  \"python\",\n  \"javascript\",\n  \"typescript\",\n  \"java\",\n  \"c++\",\n  \"c#\",\n  \"golang\",\n  \"go developer\",\n  \"rust\",\n  \"php\",\n  \"ruby\",\n  \"react\",\n  \"angular\",\n  \"vue\",\n  \"node.js\",\n  \"nodejs\",\n  \"fastapi\",\n  \"django\",\n  \"flask\",\n  \"backend\",\n  \"frontend\",\n  \"full stack\",\n  \"fullstack\",\n  \"software engineer\",\n  \"software developer\",\n  \"web developer\",\n  \"ai engineer\",\n  \"ai developer\",\n  \"machine learning\",\n  \"deep learning\",\n  \"data scientist\",\n  \"data engineer\",\n  \"devops\",\n  \"cloud engineer\",\n  \"aws\",\n  \"azure\",\n  \"gcp\",\n  \"docker\",\n  \"kubernetes\",\n  \"cybersecurity\",\n  \"cyber security\",\n  \"database\",\n  \"sql\",\n  \"api\",\n  \"qa engineer\",\n  \"test engineer\",\n  \"qa automation\"\n];\n\nreturn $input.all()\n  .filter(item => {\n    const job = item.json;\n\n    const title = job.position || \"\";\n\n    const description = job.description || \"\";\n\n    const tags = Array.isArray(job.tags)\n      ? job.tags.join(\" \")\n      : \"\";\n\n    const text = (\n      title + \" \" +\n      description + \" \" +\n      tags\n    ).toLowerCase();\n\n    return techKeywords.some(keyword =>\n      text.includes(keyword.toLowerCase())\n    );\n  })\n  .map(item => {\n    const job = item.json;\n\n    return {\n      json: {\n        source: \"Remote OK\",\n\n        source_id: String(job.id || job.slug || \"\"),\n\n        title: job.position || \"\",\n\n        company: job.company || \"\",\n\n        description: job.description || \"\",\n\n        location: job.location || \"\",\n\n        url: job.url || job.apply_url || \"\",\n\n        tags: Array.isArray(job.tags)\n          ? job.tags\n          : [],\n\n        salary_min: null,\n\n        salary_max: null,\n\n        date_posted: job.date || job.posted || null\n      }\n    };\n  });"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        752,
        -80
      ],
      "id": "62ab5208-c122-4782-9c40-09595ef058b1",
