    {
      "parameters": {
        "jsCode": "const seenUrls = new Set();\nconst seenCompanyTitles = new Set();\n\nconst uniqueJobs = [];\n\nfor (const item of $input.all()) {\n  const job = item.json;\n\n  const url = (job.url || \"\")\n    .toLowerCase()\n    .trim();\n\n  const company = (job.company || \"\")\n    .toLowerCase()\n    .trim()\n    .replace(/[^a-z0-9]/g, \"\");\n\n  const title = (job.title || \"\")\n    .toLowerCase()\n    .trim()\n    .replace(/[^a-z0-9]/g, \"\");\n\n  const companyTitleKey = `${company}|${title}`;\n\n  // Duplicate if either URL or company + title already exists\n  if (\n    (url && seenUrls.has(url)) ||\n    seenCompanyTitles.has(companyTitleKey)\n  ) {\n    continue;\n  }\n\n  if (url) {\n    seenUrls.add(url);\n  }\n\n  seenCompanyTitles.add(companyTitleKey);\n\n  uniqueJobs.push(item);\n}\n\nreturn uniqueJobs;"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
