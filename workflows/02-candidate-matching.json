      "id": "7a1d1c7a-4348-4369-b3c9-a5ad64579f09",
      "name": "Get many rows"
    },
    {
      "parameters": {
        "jsCode": "const rankings = $('Collect Rankings').first().json.rankings;\nconst jobChunks = $input.all();\n\nconst jobsBySourceId = new Map();\n\nfor (const item of jobChunks) {\n  const metadata = item.json.metadata || {};\n  const sourceId = metadata[\"source_id\"];\n\n  if (!sourceId) continue;\n\n  const id = String(sourceId);\n\n  if (!jobsBySourceId.has(id)) {\n    jobsBySourceId.set(id, []);\n  }\n\n  jobsBySourceId.get(id).push(item.json);\n}\n\nconst results = [];\n\nfor (const evaluation of rankings) {\n  const chunks = jobsBySourceId.get(String(evaluation.source_id));\n\n  if (!chunks || chunks.length === 0) {\n    continue;\n  }\n\n  const firstMetadata = chunks[0].metadata || {};\n\n  const fullDescription = chunks\n    .map(chunk => {\n      const metadata = chunk.metadata || {};\n      return metadata[\"description  \"] || chunk.content || \"\";\n    })\n    .join(\"\\n\\n\");\n\n  results.push({\n    json: {\n      source_id: evaluation.source_id,\n      fit_score: evaluation.fit_score,\n      explanation: evaluation.explanation,\n      red_flags: evaluation.red_flags,\n      recommended_action: evaluation.recommended_action,\n\n      title: firstMetadata[\"title \"] || \"\",\n      company: firstMetadata[\"company \"] || \"\",\n      location: firstMetadata[\"location \"] || \"\",\n      url: firstMetadata[\"url \"] || \"\",\n      source: firstMetadata[\"source \"] || \"\",\n      tags: firstMetadata.tags || [],\n\n      description: fullDescription\n    }\n  });\n}\n\nreturn results;"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1984,
        -928
      ],
      "id": "8b780d14-ddd3-4176-91f2-16e2c0519e19",
      "name": "Code in JavaScript"
    },
    {
      "parameters": {
        "jsCode": "const rankings = $input.all().map(item => item.json);\n\nreturn [\n  {\n    json: {\n      rankings\n    }\n  }\n];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
