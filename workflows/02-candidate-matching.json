    {
      "parameters": {
        "jsCode": "const chunks = $json.profile_chunks || [];\n\nconst profileText = chunks\n  .map(chunk => chunk.content || \"\")\n  .filter(Boolean)\n  .join(\"\\n\\n\");\n\nreturn [\n  {\n    json: {\n      profile_text: profileText\n    }\n  }\n];"
