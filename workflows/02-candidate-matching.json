      ],
      "id": "be75e9a5-4c77-4622-b724-ba0f6e1bc4c8",
      "name": "Collect Rankings"
    },
    {
      "parameters": {
        "jsCode": "const items = $input.all();\n\nitems.sort((a, b) => {\n  return Number(b.json.fit_score || 0) - Number(a.json.fit_score || 0);\n});\n\nreturn items;"
      },
